{
  "project": "Round Display UI Synth",
  "display": {
    "type": "Round Touch",
    "diameter_inch": 1.75,
    "resolution_px": 360,
    "ui_modes": {
      "main_menu": "RadialCarousel",
      "submenu": "CurvedList",
      "parameter_edit": "RingGauge"
    }
  },
  "main_menus": [
    {
      "id": 1,
      "key": "PLAY",
      "title": "Mode Play & Auto",
      "icon": "icon_play",
      "color": "#FF0055",
      "submenus": [
        { 
          "id": "play_bpm", 
          "label": "BPM", 
          "type": "INT", 
          "min": 1, 
          "max": 200, 
          "step": 1, 
          "default": 120, 
          "unit": "BPM" 
        },
        { 
          "id": "play_root", 
          "label": "Root", 
          "type": "ENUM", 
          "options": [
            "C",
            "C#",
            "D",
            "D#",
            "E ",
            "F ",
            "F#",
            "G ",
            "G#",
            "A",
            "A#",
            "B"
          ], 
          "default": 9 
        },
        { 
          "id": "play_scale", 
          "label": "Scale", 
          "type": "ENUM", 
          "options": [
            "M",
            "m",
            "m harm",
            "m melo",
            "Pent M",
            "Pent m",
            "Blues",
            "Chrom"
          ], 
          "default": 0 
        },
        { 
          "id": "play_chords", 
          "label": "Chords", 
          "type": "ENUM", 
          "options": [
            "Mono",
            "Triad",
            "7 dom",
            "M7",
            "m7",
            "Sus2",
            "Sus4",
            "Dim",
            "Augm",
            "Power"
          ], 
          "default": 0 
        },
        { 
          "id": "play_auto", 
          "label": "Auto", 
          "type": "INT", 
          "min": 0, 
          "max": 16, 
          "step": 1, 
          "default": 0, 
          "unit": "steps" 
        },
        { 
          "id": "play_octaves", 
          "label": "Oct", 
          "type": "INT", 
          "min": -24, 
          "max": 24, 
          "step": 1, 
          "default": 0, 
          "unit": "st" 
        },
        { 
          "id": "play_poly_steps", 
          "label": "Step", 
          "type": "INT", 
          "min": 1, 
          "max": 32, 
          "step": 1, 
          "default": 16, 
          "unit": "steps" 
        },
        { 
          "id": "play_poly_div", 
          "label": "Div", 
          "type": "ENUM", 
          "options": [
            "1/1",
            "1/2",
            "1/4",
            "1/4T",
            "1/8",
            "1/8T",
            "1/16",
            "1/16T",
            "1/32"
          ], 
          "default": 6 
        }
      ]
    },
